# TUBCAL_PORT=5000
# TUBCAL_ALLOWED_HOSTS=tubcal.lan   # other names for this computer that may open Tubcal
# TUBCAL_DEV_PORTS=5173,5174        # local dev servers whose pages may use Tubcal (Vite's)
# TUBCAL_PEER_CHECK=0                # answer other accounts on this computer too (a proxy run as another user)
